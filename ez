#!/usr/bin/env bash
# ezOS dev wrapper. Two ways to use:
#
#   ./ez <command> [args...]            -- run a subcommand directly
#   source ./ez                         -- expose `ez` as a shell function
#                                          + tab completion in this session
#
# Subcommands (run `./ez help` for the full list):
#
#   build [env]               -- pio run (default env: t-deck-plus)
#   flash [port]              -- pio run -t upload (USB)
#   fs                        -- pio run -t uploadfs (LittleFS image)
#   clean                     -- pio run -t clean
#   monitor [port]            -- raw serial monitor at 921600
#   remote [args...]          -- proxy to tools/remote/ez_remote.py
#   exec <lua>                -- shorthand for `remote -e <lua>`
#   logs                      -- shorthand for `remote --logs`
#   text                      -- shorthand for `remote --text`
#   shot [path]               -- shorthand for `remote -s <path>` (default /tmp/screen.png)
#   coredump [port]           -- read + decode panic coredump partition
#   docs                      -- regenerate docs/api/* from C++ annotations
#   wallpapers                -- regenerate data/wallpapers/*.jpg from sources
#
# All commands set EZOS_BUILD_SHA + EZOS_BUILD_AT automatically when they
# invoke pio so locally-flashed firmware can identify itself for the OTA
# update screen (without these the build embeds nothing and apply_url's
# downgrade-detection has nothing to compare against).

# --------------------------------------------------------------------------
# Locate ourselves so the script works from any cwd.
# --------------------------------------------------------------------------
# Different shells expose "the path of this script" through different
# variables. Bash: BASH_SOURCE[0]. Zsh when sourced: ${(%):-%x} or $0.
# Both shells set $0 to the script path when the file is executed, but
# zsh also sets $0 inside a sourced file (unlike bash where $0 is the
# parent shell name). The fallback chain below works for both.
_ez_self=""
if [[ -n "${BASH_SOURCE[0]:-}" ]]; then
    _ez_self="${BASH_SOURCE[0]}"
elif [[ -n "${ZSH_VERSION:-}" ]]; then
    # zsh: %x prompt-expansion gives the file currently being parsed,
    # which is what we want when this script is sourced.
    _ez_self="${(%):-%x}"
else
    _ez_self="$0"
fi
EZ_ROOT="$(cd "$(dirname "$_ez_self")" && pwd)"

EZ_DEFAULT_PORT="${EZOS_PORT:-/dev/ttyACM0}"
EZ_DEFAULT_ENV="${EZOS_ENV:-t-deck-plus}"

# --------------------------------------------------------------------------
# Color helpers
# --------------------------------------------------------------------------
#
# Auto-disabled when stdout isn't a terminal (CI logs, redirects, pipes
# into less, etc.) and when NO_COLOR is set per https://no-color.org.
# Inspired by the same gating curl, ripgrep, and gh use.

if [[ -t 1 ]] && [[ -z "${NO_COLOR:-}" ]] && [[ "${TERM:-}" != "dumb" ]]; then
    EZ_RED=$'\033[31m'
    EZ_GREEN=$'\033[32m'
    EZ_YELLOW=$'\033[33m'
    EZ_BLUE=$'\033[34m'
    EZ_MAGENTA=$'\033[35m'
    EZ_CYAN=$'\033[36m'
    EZ_BOLD=$'\033[1m'
    EZ_DIM=$'\033[2m'
    EZ_RESET=$'\033[0m'
else
    EZ_RED= EZ_GREEN= EZ_YELLOW= EZ_BLUE= EZ_MAGENTA= EZ_CYAN=
    EZ_BOLD= EZ_DIM= EZ_RESET=
fi

# Print a coloured message + reset. Usage: _ez_color RED "oops".
# Hand-rolled lookup table because the obvious bash idiom ${!var}
# (indirect variable expansion) isn't supported in zsh, and `eval`
# would require quoting gymnastics. The set is tiny so a case is
# clearer and survives across shells without compatibility shims.
_ez_color() {
    local color=""
    case "$1" in
        RED)     color="$EZ_RED";;
        GREEN)   color="$EZ_GREEN";;
        YELLOW)  color="$EZ_YELLOW";;
        BLUE)    color="$EZ_BLUE";;
        MAGENTA) color="$EZ_MAGENTA";;
        CYAN)    color="$EZ_CYAN";;
        BOLD)    color="$EZ_BOLD";;
        DIM)     color="$EZ_DIM";;
    esac
    printf '%s%s%s\n' "$color" "$2" "$EZ_RESET"
}

# Common helpers for the dispatch table. All write to stderr so command
# output stays grep-friendly.
_ez_say()   { _ez_color CYAN   "» $*" >&2; }
_ez_ok()    { _ez_color GREEN  "✓ $*" >&2; }
_ez_warn()  { _ez_color YELLOW "! $*" >&2; }
_ez_fail()  { _ez_color RED    "✗ $*" >&2; }

# --------------------------------------------------------------------------
# Helpers
# --------------------------------------------------------------------------

_ez_die() {
    _ez_fail "$*"
    return 1
}

_ez_set_build_stamps() {
    # The pre-build script in scripts/embed_lua_scripts.py picks these up
    # and bakes them into kOtaSigningPubkey-adjacent globals so the
    # running firmware can self-report. Same shape as the CI workflow.
    if [[ -z "${EZOS_BUILD_SHA:-}" ]]; then
        export EZOS_BUILD_SHA="$(cd "$EZ_ROOT" && git rev-parse HEAD 2>/dev/null || echo unknown)"
    fi
    if [[ -z "${EZOS_BUILD_AT:-}" ]]; then
        export EZOS_BUILD_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    fi
}

_ez_have() {
    command -v "$1" >/dev/null 2>&1
}

_ez_help() {
    # Hand-formatted with ANSI so headings/commands/descriptions get
    # different weights. Prefer this over sed-extracting the comment
    # header so the rendered help can have its own structure (groups,
    # spacing) without us round-tripping it through the source's
    # comment shape.
    local b="$EZ_BOLD"
    local d="$EZ_DIM"
    local r="$EZ_RESET"
    local c="$EZ_CYAN"
    local g="$EZ_GREEN"
    local y="$EZ_YELLOW"

    # Print the help with sections + colored columns. printf one big
    # heredoc-style string keeps the layout obvious in source.
    cat <<EOF

  ${b}${c}ezOS dev wrapper${r}

  ${d}Run a subcommand directly:${r}
      ${b}./ez${r} ${y}<command>${r} [args...]

  ${d}Or source it for tab-completion + persistent ${b}ez${r}${d} function:${r}
      ${b}source ./ez${r}

  ${b}${c}Build${r}
      ${g}build${r}        ${d}[env]${r}        pio run (default env: t-deck-plus)
      ${g}flash${r}        ${d}[port]${r}       pio run -t upload (USB)
      ${g}fs${r}                        pio run -t uploadfs (LittleFS image)
      ${g}clean${r}                     pio run -t clean

  ${b}${c}Device${r}
      ${g}monitor${r}      ${d}[port]${r}       raw serial monitor at 921600
      ${g}remote${r}       ${d}[args]${r}       proxy to tools/remote/ez_remote.py
      ${g}exec${r}         ${d}<lua>${r}        shorthand for ${b}remote -e <lua>${r}
      ${g}logs${r}                      shorthand for ${b}remote --logs${r}
      ${g}text${r}                      shorthand for ${b}remote --text${r}
      ${g}shot${r}         ${d}[path]${r}       shorthand for ${b}remote -s <path>${r}
                                  ${d}(default /tmp/screen.png)${r}
      ${g}coredump${r}     ${d}[port]${r}       read + decode panic coredump partition

  ${b}${c}Generate${r}
      ${g}docs${r}                      regenerate docs/api/* from C++ annotations
      ${g}wallpapers${r}                regenerate data/wallpapers/*.jpg

  ${b}${c}Environment${r}
      ${y}EZOS_PORT${r}    ${d}default serial port      (currently: ${EZ_DEFAULT_PORT})${r}
      ${y}EZOS_ENV${r}     ${d}default platformio env   (currently: ${EZ_DEFAULT_ENV})${r}
      ${y}NO_COLOR${r}     ${d}set to disable ANSI output${r}

  ${d}Build subcommands set ${b}EZOS_BUILD_SHA${r}${d} + ${b}EZOS_BUILD_AT${r}${d} so locally-flashed${r}
  ${d}firmware can self-identify against rolling-main in the OTA update screen.${r}

EOF
}

# --------------------------------------------------------------------------
# Subcommands
# --------------------------------------------------------------------------

_ez_cmd_build() {
    local env="${1:-$EZ_DEFAULT_ENV}"
    _ez_set_build_stamps
    _ez_say "build $env @ ${EZ_BOLD}${EZOS_BUILD_SHA:0:7}${EZ_RESET}"
    if (cd "$EZ_ROOT" && pio run -e "$env"); then
        _ez_ok "build complete"
    else
        _ez_fail "build failed"
        return 1
    fi
}

_ez_cmd_flash() {
    # Optional positional port lets you flash a device that isn't on the
    # default /dev/ttyACM0. Falls through to esptool's auto-detect when
    # explicitly given "auto".
    local port="${1:-$EZ_DEFAULT_PORT}"
    _ez_set_build_stamps
    _ez_say "flash $EZ_DEFAULT_ENV @ ${EZ_BOLD}${EZOS_BUILD_SHA:0:7}${EZ_RESET} -> $port"
    local rc
    if [[ "$port" == "auto" ]]; then
        (cd "$EZ_ROOT" && pio run -e "$EZ_DEFAULT_ENV" -t upload); rc=$?
    else
        (cd "$EZ_ROOT" && pio run -e "$EZ_DEFAULT_ENV" -t upload --upload-port "$port"); rc=$?
    fi
    if [[ $rc -eq 0 ]]; then
        _ez_ok "flashed"
    else
        _ez_fail "flash failed"
    fi
    return $rc
}

_ez_cmd_fs() {
    _ez_set_build_stamps
    _ez_say "uploadfs (LittleFS image)"
    if (cd "$EZ_ROOT" && pio run -e "$EZ_DEFAULT_ENV" -t uploadfs); then
        _ez_ok "fs uploaded"
    else
        _ez_fail "fs upload failed"
        return 1
    fi
}

_ez_cmd_clean() {
    _ez_say "clean"
    (cd "$EZ_ROOT" && pio run -e "$EZ_DEFAULT_ENV" -t clean)
}

_ez_cmd_monitor() {
    local port="${1:-$EZ_DEFAULT_PORT}"
    if _ez_have picocom; then
        picocom -b 921600 --imap lfcrlf "$port"
    else
        # Fallback: pio's monitor (slower to start but always available).
        (cd "$EZ_ROOT" && pio device monitor --port "$port" --baud 921600)
    fi
}

_ez_cmd_remote() {
    python3 "$EZ_ROOT/tools/remote/ez_remote.py" "$EZ_DEFAULT_PORT" "$@"
}

_ez_cmd_exec() {
    if [[ $# -lt 1 ]]; then _ez_die "exec needs a Lua expression"; return $?; fi
    python3 "$EZ_ROOT/tools/remote/ez_remote.py" "$EZ_DEFAULT_PORT" -e "$*"
}

_ez_cmd_logs() {
    python3 "$EZ_ROOT/tools/remote/ez_remote.py" "$EZ_DEFAULT_PORT" --logs
}

_ez_cmd_text() {
    python3 "$EZ_ROOT/tools/remote/ez_remote.py" "$EZ_DEFAULT_PORT" --text
}

_ez_cmd_shot() {
    local out="${1:-/tmp/screen.png}"
    if python3 "$EZ_ROOT/tools/remote/ez_remote.py" "$EZ_DEFAULT_PORT" -s "$out" >/dev/null 2>&1; then
        _ez_ok "screenshot -> $out"
    else
        _ez_fail "screenshot failed"
        return 1
    fi
}

_ez_cmd_coredump() {
    local port="${1:-$EZ_DEFAULT_PORT}"
    "$EZ_ROOT/tools/read_coredump.sh" "$port"
}

_ez_cmd_docs() {
    (cd "$EZ_ROOT" && python3 tools/generate_lua_docs.py)
}

_ez_cmd_wallpapers() {
    (cd "$EZ_ROOT" && python3 tools/gen_wallpapers.py "$@")
}

_ez_cmd_help() {
    _ez_help
}

# --------------------------------------------------------------------------
# Dispatch
# --------------------------------------------------------------------------

ez() {
    local cmd="${1:-help}"
    shift || true
    case "$cmd" in
        build|b)        _ez_cmd_build "$@";;
        flash|upload|u) _ez_cmd_flash "$@";;
        fs|uploadfs)    _ez_cmd_fs "$@";;
        clean)          _ez_cmd_clean "$@";;
        monitor|m)      _ez_cmd_monitor "$@";;
        remote|r)       _ez_cmd_remote "$@";;
        exec|e)         _ez_cmd_exec "$@";;
        logs|l)         _ez_cmd_logs "$@";;
        text|t)         _ez_cmd_text "$@";;
        shot|s)         _ez_cmd_shot "$@";;
        coredump)       _ez_cmd_coredump "$@";;
        docs)           _ez_cmd_docs "$@";;
        wallpapers|wp)  _ez_cmd_wallpapers "$@";;
        help|--help|-h) _ez_cmd_help;;
        *)
            _ez_die "unknown command: $cmd (try \`ez help\`)"
            return 1
            ;;
    esac
}

# Bash completion. Only registers when the script is sourced, since the
# completion needs to live in the calling shell's environment.
_ez_completions() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    local cmds="build flash fs clean monitor remote exec logs text shot coredump docs wallpapers help"
    if [[ $COMP_CWORD -eq 1 ]]; then
        COMPREPLY=( $(compgen -W "$cmds" -- "$cur") )
    fi
}

# --------------------------------------------------------------------------
# Entry point
# --------------------------------------------------------------------------

# Detect "is this script being sourced or executed?". When sourced,
# leave the `ez` function defined and don't run anything; the caller can
# call `ez <cmd>` interactively. When executed, dispatch immediately.
#
# zsh and bash differ here: in bash, $0 inside a sourced file is the
# parent shell name (e.g. "bash") while BASH_SOURCE[0] is the script
# path. In zsh, $0 is the script path even when sourced, but
# ZSH_EVAL_CONTEXT contains "file" when sourced. We check both.
_ez_sourced=false
if [[ -n "${BASH_SOURCE[0]:-}" ]] && [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
    _ez_sourced=true
elif [[ -n "${ZSH_VERSION:-}" ]] && [[ "${ZSH_EVAL_CONTEXT:-}" == *:file ]]; then
    _ez_sourced=true
fi

if ! $_ez_sourced; then
    # Executed directly.
    ez "$@"
    exit $?
else
    # Sourced. Hook up tab completion if the shell supports it.
    if [[ -n "${BASH_VERSION:-}" ]]; then
        complete -F _ez_completions ez
    elif [[ -n "${ZSH_VERSION:-}" ]]; then
        # zsh has a different completion system. Do the minimum: a
        # function that emits the subcommand list. Users with a
        # configured completion system pick this up automatically.
        _ez_zsh_complete() { _values 'ez subcommand' \
            'build' 'flash' 'fs' 'clean' 'monitor' 'remote' 'exec' \
            'logs' 'text' 'shot' 'coredump' 'docs' 'wallpapers' 'help'; }
        compdef _ez_zsh_complete ez 2>/dev/null
    fi
    _ez_ok "ez ready -- try ${EZ_BOLD}ez help${EZ_RESET}"
fi
