# PlatformIO build directory
.pio/

# Auto-generated embedded Lua scripts + docs (regenerated on each build)
src/lua/embedded_lua_scripts.cpp
src/lua/embedded_lua_scripts.h
src/lua/embedded_docs.cpp
src/lua/embedded_docs.h

# Auto-generated embedded binary assets (boot logo, etc.)
src/generated/embedded_assets.cpp
src/generated/embedded_assets.h

# IDE settings
.idea/
.vscode/

# macOS
.DS_Store

# Python
__pycache__/
*.pyc
venv/
.venv/

# Large map data files
*.osm.pbf
*.pmtiles
*.tdmap
tools/maps/*.checkpoint

# Screenshots
*.png
!/docs/screenshots/*.png
!/assets/**/*.png
node_modules/

# Generated docs
/docs/api/
/docs/manual/
/docs/index.html

# Generated web console (built by .github/workflows/docs.yml via `npm run
# build` in console/; output goes here and is uploaded as part of the
# Pages artifact alongside the manual/API reference).
/docs/console/
/console/node_modules/
/console/dist/

# Claude local state (per-machine). Shared skills under .claude/skills/
# are tracked; settings.local.json holds machine-specific permissions.
.claude/settings.local.json
.claude/projects/

# Raw asset source trees (only processed outputs are tracked)
wallpapers-in/
tools/bin/
tools/fonts/
